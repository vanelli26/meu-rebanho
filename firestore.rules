rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function membro(fazendaId) {
      return logado() &&
        request.auth.uid in get(/databases/$(database)/documents/fazendas/$(fazendaId)).data.membros;
    }

    function dono(fazendaId) {
      return logado() &&
        get(/databases/$(database)/documents/fazendas/$(fazendaId)).data.membros[request.auth.uid] == "dono";
    }

    match /usuarios/{uid} {
      allow read, create, update: if logado() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /fazendas/{fazendaId} {
      // Só o próprio usuário como único membro e dono.
      allow create: if logado()
        && request.resource.data.donoUid == request.auth.uid
        && request.resource.data.membros.keys().hasOnly([request.auth.uid])
        && request.resource.data.membros[request.auth.uid] == "dono"
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0;

      // resource == null: o app escuta a fazenda recém-criada antes de ela chegar
      // ao servidor. Ler um documento inexistente não expõe nada.
      allow read: if logado() && (resource == null || request.auth.uid in resource.data.membros);

      // O dono edita, mas não pode trocar o dono nem se remover.
      allow update: if logado()
        && resource.data.membros[request.auth.uid] == "dono"
        && request.resource.data.donoUid == resource.data.donoUid
        && request.resource.data.membros[resource.data.donoUid] == "dono";

      allow delete: if false;

      // Subcoleções (animais, eventos, produção...). Não usar /{sub=**} aqui: no
      // rules_version 2 ele também casa com o próprio documento da fazenda.
      match /{colecao}/{resto=**} {
        allow read, write: if membro(fazendaId) && !(colecao in ['precosLeite', 'despesas']);
      }

      // Financeiro: só o dono, mesmo quando houver funcionários.
      // O id do preço é a data de início (cadastrar de novo no mesmo dia substitui).
      match /precosLeite/{inicio} {
        allow read, delete: if dono(fazendaId);
        allow create, update: if dono(fazendaId)
          && request.resource.data.inicio == inicio
          && request.resource.data.valorLitro is number
          && request.resource.data.valorLitro > 0;
      }

      match /despesas/{despesaId} {
        allow read, write: if dono(fazendaId);
      }
    }

    // Eventos de todos os animais, lidos por grupo de coleção (a consulta filtra
    // por fazendaId). Mantém o histórico no cache para recalcular resumos offline.
    match /{caminho=**}/eventos/{eventoId} {
      allow read: if membro(resource.data.fazendaId);
    }

    // Tratamentos de todos os animais, pelo mesmo motivo (carências calculadas offline).
    match /{caminho=**}/tratamentos/{tratamentoId} {
      allow read: if membro(resource.data.fazendaId);
    }
  }
}
